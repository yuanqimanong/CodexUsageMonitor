<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF17212A"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF22303A"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#78D9F2FF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFF0F9FC"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFD1DEE5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF65E6C4"/>
    <SolidColorBrush x:Key="HealthyBrush" Color="#FF65E6C4"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFCE78"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="#FFFF737D"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#34374651"/>
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#303D5260"/>
    <SolidColorBrush x:Key="ChromePressedBrush" Color="#48516674"/>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#C09BACB6"/>
    <SolidColorBrush x:Key="VersionBrush" Color="#FFB9C9D0"/>
    <SolidColorBrush x:Key="GlowBrush" Color="#4065E6C4"/>
    <Color x:Key="WindowShadowColor">#FF00131C</Color>
    <Color x:Key="TextShadowColor">#FF02070A</Color>
    <sys:Double x:Key="WindowShadowOpacity">0.18</sys:Double>
    <sys:Double x:Key="TextShadowOpacity">0.68</sys:Double>
    <sys:Double x:Key="ThemeDecorationOpacity">0.15</sys:Double>
</ResourceDictionary>
