<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F20A0820"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF151035"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#D000F5FF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF4FFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF6FFAFF"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFAE83D9"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF00F5FF"/>
    <SolidColorBrush x:Key="HealthyBrush" Color="#FF00F5FF"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF9F871"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="#FFFF3CAC"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FF241A49"/>
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#FF25205A"/>
    <SolidColorBrush x:Key="ChromePressedBrush" Color="#FF342871"/>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#FF745B99"/>
    <SolidColorBrush x:Key="VersionBrush" Color="#FF67527F"/>
    <SolidColorBrush x:Key="GlowBrush" Color="#7000F5FF"/>
    <Color x:Key="WindowShadowColor">#FF001E2A</Color>
    <Color x:Key="TextShadowColor">#FF00040A</Color>
    <sys:Double x:Key="WindowShadowOpacity">0.72</sys:Double>
    <sys:Double x:Key="TextShadowOpacity">0.42</sys:Double>
    <sys:Double x:Key="ThemeDecorationOpacity">1</sys:Double>
</ResourceDictionary>
