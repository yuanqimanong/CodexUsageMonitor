<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF0A0A0A"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF171717"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#FF383838"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFD2D2D2"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF858585"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="HealthyBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="#FF999999"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FF292929"/>
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#FF252525"/>
    <SolidColorBrush x:Key="ChromePressedBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#FF777777"/>
    <SolidColorBrush x:Key="VersionBrush" Color="#FF555555"/>
    <SolidColorBrush x:Key="GlowBrush" Color="#00FFFFFF"/>
    <Color x:Key="WindowShadowColor">#FF000000</Color>
    <Color x:Key="TextShadowColor">#FF000000</Color>
    <sys:Double x:Key="WindowShadowOpacity">0.46</sys:Double>
    <sys:Double x:Key="TextShadowOpacity">0.24</sys:Double>
    <sys:Double x:Key="ThemeDecorationOpacity">0</sys:Double>
</ResourceDictionary>
