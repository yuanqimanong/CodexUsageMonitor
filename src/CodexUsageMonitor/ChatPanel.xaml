<UserControl x:Class="CodexUsageMonitor.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodexUsageMonitor"
             FontFamily="Microsoft YaHei UI" FontSize="11"
             Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="TokenNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource SurfaceBorderBrush}" CornerRadius="3" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="ContentLayout" Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="29"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SessionCount" Text="正在运行" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="调用完成后更新 · 每 3 秒读取" Margin="12,1,0,0" Style="{StaticResource Caption}"/>
        </Grid>
        <ScrollViewer x:Name="CardScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SessionCards" AutomationProperties.Name="运行中的会话">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="{x:Static local:ChatPanel.CardHeight}" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Speed}" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontFamily="Segoe UI Semibold"/>
                                        <TextBlock Text="Token/s" Style="{StaticResource Caption}" Margin="6,0,0,4" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Detail}" ToolTip="{Binding Detail}" Margin="0,2,0,0" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Row="2" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                  <UniformGrid Columns="4">
                                    <StackPanel><TextBlock Text="输入" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Input}" ToolTip="{Binding InputExact}" Style="{StaticResource TokenNumber}"/></StackPanel>
                                    <StackPanel><TextBlock Text="缓存输入" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Cached}" ToolTip="{Binding CachedExact}" Style="{StaticResource TokenNumber}"/></StackPanel>
                                    <StackPanel><TextBlock Text="输出" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Output}" ToolTip="{Binding OutputExact}" Style="{StaticResource TokenNumber}"/></StackPanel>
                                    <StackPanel><TextBlock Text="思考输出" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Reasoning}" ToolTip="{Binding ReasoningExact}" Style="{StaticResource TokenNumber}"/></StackPanel>
                                  </UniformGrid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" Margin="20">
            <TextBlock x:Name="EmptyTitle" Text="还没有正在运行的会话" FontSize="15" TextAlignment="Center"/>
            <TextBlock x:Name="EmptyHint" Text="在 Codex 中发送一条消息，卡片会自动出现在这里。" Margin="0,10,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Token 为累计 · 速度为最近一次调用" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="数据目录…" Width="88" FontSize="10" FontFamily="Microsoft YaHei UI"
                Style="{StaticResource ChromeButtonStyle}" HorizontalAlignment="Right" Click="ChooseDirectory_Click"/>
        </Grid>
    </Grid>
</UserControl>
