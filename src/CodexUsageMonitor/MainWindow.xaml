<Window x:Class="CodexUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexUsageMonitor"
        Title="Codex Usage Monitor"
        Width="520"
        Height="326"
        MinWidth="36"
        MinHeight="36"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="DragSurface" Background="Transparent"
          MouseEnter="WindowSurface_MouseEnter"
          MouseLeave="WindowSurface_MouseLeave"
          MouseLeftButtonDown="WindowSurface_MouseLeftButtonDown"
          MouseMove="WindowSurface_MouseMove"
          MouseLeftButtonUp="WindowSurface_MouseLeftButtonUp"
          LostMouseCapture="WindowSurface_LostMouseCapture">
      <Grid x:Name="WindowSurface"
            Margin="14"
            AutomationProperties.HelpText="拖动到屏幕任意边缘即可磁吸">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="切换皮肤" Click="ThemeButton_Click"/>
                <Separator/>
                <MenuItem Header="吸附到左侧"
                          Click="DockLeftMenuItem_Click"/>
                <MenuItem Header="吸附到右侧"
                          Click="DockRightMenuItem_Click"/>
                <MenuItem Header="吸附到顶部"
                          Click="DockTopMenuItem_Click"/>
                <MenuItem Header="吸附到底部"
                          Click="DockBottomMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="拖动磁吸开关位于托盘菜单"
                          IsEnabled="False"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Border x:Name="SurfaceBorder"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect x:Name="SurfaceShadowEffect"
                                  BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="{DynamicResource WindowShadowOpacity}"
                                  Color="{DynamicResource WindowShadowColor}"/>
            </Border.Effect>
            <Grid ClipToBounds="True">
              <Grid x:Name="FullPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="16,6,16,4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="QuotaTab" Content="额度" Width="60" FontFamily="Microsoft YaHei UI" FontSize="12"
                                Style="{StaticResource ChromeButtonStyle}" Click="QuotaTab_Click"/>
                        <Button x:Name="ChatTab" Content="会话" Width="60" FontFamily="Microsoft YaHei UI" FontSize="12"
                                Style="{StaticResource ChromeButtonStyle}" Click="ChatTab_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="KeepOpenButton" Content="◇" Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="保持展开" Click="KeepOpenButton_Click"/>
                            <Button x:Name="CollapseButton" Content="◁" Style="{StaticResource ChromeButtonStyle}" ToolTip="收起到边缘" Click="CollapseButton_Click"/>
                            <Button x:Name="ThemeButton" Content="◈" Style="{StaticResource ChromeButtonStyle}" ToolTip="切换皮肤" Click="ThemeButton_Click"/>
                            <Button x:Name="RefreshButton" Content="↻" Style="{StaticResource ChromeButtonStyle}" ToolTip="立即刷新" Click="RefreshButton_Click"/>
                            <Button Content="×" Style="{StaticResource ChromeButtonStyle}" ToolTip="隐藏到托盘" Click="HideButton_Click"/>
                    </StackPanel>
                </Grid>
                <local:ChatPanel x:Name="ChatView" Grid.Row="1" Visibility="Collapsed"/>
                <Grid x:Name="QuotaPanel" Grid.Row="1" Margin="16,8,16,12"
                      TextOptions.TextFormattingMode="Display">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="29"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0"
                                     Fill="{DynamicResource StatusIdleBrush}"/>
                            <TextBlock Text="账户额度" FontFamily="Microsoft YaHei UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="PlanText" Margin="8,1,0,0" MaxWidth="120"
                                       FontFamily="Segoe UI" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="ConnectionText" Grid.Column="1" MaxWidth="160" Margin="12,1,0,0"
                                   FontFamily="Microsoft YaHei UI" FontSize="10" Text="正在连接"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}"/>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="68"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RemainingText" VerticalAlignment="Center"
                                           FontFamily="Segoe UI Light" FontSize="44" Text="--%"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="剩余用量" FontFamily="Microsoft YaHei UI" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="FetchedText" Margin="0,5,0,0" FontSize="11"
                                               Text="等待 Codex 数据" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="UsageProgress" Grid.Row="1" VerticalAlignment="Center"
                                         Value="0" Style="{StaticResource UsageProgressStyle}"/>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                <TextBlock x:Name="PrimaryWindowText" FontFamily="Microsoft YaHei UI" FontSize="11"
                                           Text="正在读取限额窗口…" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="SecondaryWindowText" Margin="0,6,0,0" FontFamily="Microsoft YaHei UI"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FooterText" Margin="0,0,12,0" VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei UI" FontSize="10" TextTrimming="CharacterEllipsis"
                                   Text="Codex Desktop · 每分钟兜底刷新" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="10"
                                   Foreground="{DynamicResource VersionBrush}"/>
                    </Grid>
              </Grid>
              </Grid>

              <Grid x:Name="CompactPanel"
                    Visibility="Collapsed"
                    Margin="0"
                    ToolTipService.InitialShowDelay="1500"
                    ToolTip="悬停或双击展开；拖动可脱离吸附">
                  <TextBlock x:Name="MiniRemainingText"
                             Margin="2"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             FontFamily="Segoe UI Semibold"
                             FontSize="11"
                             TextAlignment="Center"
                             TextTrimming="None"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Text="--"/>
                  <Ellipse x:Name="MiniStatusDot"
                           Width="4"
                           Height="4"
                           Margin="0,5,5,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Fill="{DynamicResource StatusIdleBrush}"/>
              </Grid>
            </Grid>
        </Border>
      </Grid>
    </Grid>
</Window>
