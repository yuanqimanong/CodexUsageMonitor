<Window x:Class="CodexUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexUsageMonitor"
        Title="Codex Usage Monitor"
        Width="392"
        Height="286"
        MinWidth="36"
        MinHeight="36"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="DragSurface" Background="Transparent"
          MouseEnter="WindowSurface_MouseEnter"
          MouseLeave="WindowSurface_MouseLeave"
          MouseLeftButtonDown="WindowSurface_MouseLeftButtonDown"
          MouseMove="WindowSurface_MouseMove"
          MouseLeftButtonUp="WindowSurface_MouseLeftButtonUp"
          LostMouseCapture="WindowSurface_LostMouseCapture">
      <Grid x:Name="WindowSurface"
            Margin="14"
            AutomationProperties.HelpText="拖动到屏幕任意边缘即可磁吸">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="切换皮肤" Click="ThemeButton_Click"/>
                <Separator/>
                <MenuItem Header="吸附到左侧"
                          Click="DockLeftMenuItem_Click"/>
                <MenuItem Header="吸附到右侧"
                          Click="DockRightMenuItem_Click"/>
                <MenuItem Header="吸附到顶部"
                          Click="DockTopMenuItem_Click"/>
                <MenuItem Header="吸附到底部"
                          Click="DockBottomMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="拖动磁吸开关位于托盘菜单"
                          IsEnabled="False"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Border x:Name="SurfaceBorder"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect x:Name="SurfaceShadowEffect"
                                  BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="{DynamicResource WindowShadowOpacity}"
                                  Color="{DynamicResource WindowShadowColor}"/>
            </Border.Effect>
            <Grid ClipToBounds="True">
              <Grid x:Name="FullPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="14,5,14,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="QuotaTab" Content="额度" Width="56" FontFamily="Microsoft YaHei UI" FontSize="11"
                                Style="{StaticResource ChromeButtonStyle}" Click="QuotaTab_Click"/>
                        <Button x:Name="ChatTab" Content="会话" Width="56" FontFamily="Microsoft YaHei UI" FontSize="11"
                                Style="{StaticResource ChromeButtonStyle}" Click="ChatTab_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="KeepOpenButton" Content="◇" Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="保持展开" Click="KeepOpenButton_Click"/>
                            <Button x:Name="CollapseButton" Content="◁" Style="{StaticResource ChromeButtonStyle}" ToolTip="收起到边缘" Click="CollapseButton_Click"/>
                            <Button x:Name="ThemeButton" Content="◈" Style="{StaticResource ChromeButtonStyle}" ToolTip="切换皮肤" Click="ThemeButton_Click"/>
                            <Button x:Name="RefreshButton" Content="↻" Style="{StaticResource ChromeButtonStyle}" ToolTip="立即刷新" Click="RefreshButton_Click"/>
                            <Button Content="×" Style="{StaticResource ChromeButtonStyle}" ToolTip="隐藏到托盘" Click="HideButton_Click"/>
                    </StackPanel>
                </Grid>
                <local:ChatPanel x:Name="ChatView" Grid.Row="1" Visibility="Collapsed"/>
                <Grid x:Name="QuotaPanel" Grid.Row="1">
                <Canvas IsHitTestVisible="False"
                        Opacity="{DynamicResource ThemeDecorationOpacity}">
                    <Line X1="0" Y1="44" X2="364" Y2="44"
                          Stroke="{DynamicResource GlowBrush}"
                          StrokeThickness="1"/>
                    <Line X1="280" Y1="0" X2="364" Y2="84"
                          Stroke="{DynamicResource GlowBrush}"
                          StrokeThickness="1"/>
                    <Line X1="305" Y1="0" X2="364" Y2="59"
                          Stroke="{DynamicResource GlowBrush}"
                          StrokeThickness="1"/>
                    <Rectangle Canvas.Left="5"
                               Canvas.Top="5"
                               Width="27"
                               Height="3"
                               Fill="{DynamicResource GlowBrush}"/>
                    <Rectangle Canvas.Left="335"
                               Canvas.Top="190"
                               Width="24"
                               Height="3"
                               Fill="{DynamicResource GlowBrush}"/>
                    <TextBlock Canvas.Left="273"
                               Canvas.Top="172"
                               FontFamily="Consolas"
                               FontSize="8"
                               Foreground="{DynamicResource GlowBrush}"
                               Text="SYS://QUOTA"/>
                </Canvas>

                <Grid Margin="18,14,18,13"
                      TextOptions.TextFormattingMode="Display"
                      TextOptions.TextHintingMode="Fixed"
                      TextOptions.TextRenderingMode="Grayscale">
                    <Grid.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Effect"
                                    Value="{DynamicResource ContentLegibilityEffect}"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="67"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot"
                                 Width="8"
                                 Height="8"
                                 Margin="0,0,9,0"
                                 Fill="{DynamicResource StatusIdleBrush}"
                                 VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="CODEX"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="PlanText"
                                       Margin="7,0,0,0"
                                       MaxWidth="68"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="ConnectionText"
                                   Grid.Column="2"
                                   Margin="0,0,5,0"
                                   MaxWidth="82"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="正在连接"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RemainingText"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Light"
                                   FontSize="43"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="--%"/>
                        <StackPanel Grid.Column="1"
                                    Margin="13,9,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontFamily="Microsoft YaHei UI"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="剩余用量"/>
                            <TextBlock x:Name="FetchedText"
                                       Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="等待 Codex 数据"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="UsageProgress"
                                 Grid.Row="2"
                                 Margin="0,0,0,2"
                                 Value="0"
                                 Style="{StaticResource UsageProgressStyle}"/>

                    <StackPanel Grid.Row="3"
                                Margin="0,6,0,0">
                        <TextBlock x:Name="PrimaryWindowText"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="正在读取限额窗口…"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SecondaryWindowText"
                                   Margin="0,4,0,0"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text=""
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FooterText"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Bottom"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Codex Desktop · 每分钟兜底刷新"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontFamily="Segoe UI"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource VersionBrush}"
                                   Text="v1.1"/>
                    </Grid>
                </Grid>
              </Grid>
              </Grid>

              <Grid x:Name="CompactPanel"
                    Visibility="Collapsed"
                    Margin="0"
                    ToolTipService.InitialShowDelay="1500"
                    ToolTip="悬停或双击展开；拖动可脱离吸附">
                  <TextBlock x:Name="MiniRemainingText"
                             Margin="2"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             FontFamily="Segoe UI Semibold"
                             FontSize="11"
                             TextAlignment="Center"
                             TextTrimming="None"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Text="--"/>
                  <Ellipse x:Name="MiniStatusDot"
                           Width="4"
                           Height="4"
                           Margin="0,5,5,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Fill="{DynamicResource StatusIdleBrush}"/>
              </Grid>
            </Grid>
        </Border>
      </Grid>
    </Grid>
</Window>
